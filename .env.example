# Copy this file to ".env" and fill in real values. ".env" is gitignored.
# When adding variables, also update the schema in "src/env.js".

# ----------------------------------------------------------------------------
# Branding (display titles)
# ----------------------------------------------------------------------------
# Change these to rebrand the app without touching code. Leave unset to use the
# defaults shown below (defined in src/env.js). Read via src/lib/branding.ts.
# Both are NEXT_PUBLIC_* and inlined at build time, so rebuild after changing.

# Public-facing title (landing page, tutee/tutor signup, page <title>s).
NEXT_PUBLIC_APP_TITLE="SHBS Peer Tutoring"
# Title for the tutor/coordinator/admin management area ("the team").
NEXT_PUBLIC_TEAM_TITLE="SHBS Peer Tutoring Team"

# Optional program-identity labels (white-labeling). Leave blank to fall back (org -> app title).
# Organization / school name (report letterhead, emails, footer).
NEXT_PUBLIC_ORG_NAME=""
# Public support / contact email (shown in the footer when set).
NEXT_PUBLIC_SUPPORT_EMAIL=""
# Display label for the program season/year, e.g. "2025-26".
NEXT_PUBLIC_PROGRAM_TERM_LABEL=""

# Translation / white-labelling (i18n via next-intl): UI strings live in messages/<locale>.json
# and the active locale comes from the NEXT_LOCALE cookie (switcher in the app header).
# To re-word the app for another org WITHOUT editing those files, set MESSAGES_OVERRIDE to a
# JSON object that is deep-merged over the active locale's messages. Leave empty to use defaults.
# Example: MESSAGES_OVERRIDE={"dashboard":{"attendance":{"title":"Log a session"}}}
MESSAGES_OVERRIDE=""

# ----------------------------------------------------------------------------
# Auth.js
# ----------------------------------------------------------------------------
# Sign-in is email + password (Credentials provider). A future email-based 2FA
# second factor is scaffolded but not yet implemented — when an email provider is
# chosen, its config will be added here (see src/server/email/sender.ts).

# Session/JWT signing secret. Generate with: npx auth secret
AUTH_SECRET=""

# Optional: comma-separated emails granted ADMIN on first sign-in (bootstrap).
# Leave empty once a real admin exists and can promote others in-app.
AUTH_BOOTSTRAP_ADMIN_EMAILS=""

# Dev only: set to "true" to inject a 100–500ms artificial delay into every tRPC call
# (surfaces request waterfalls). Off by default so local dev is snappy. No effect in prod.
TRPC_DEV_DELAY="false"

# ----------------------------------------------------------------------------
# Email — Aliyun Direct Mail (邮件推送) over SMTP
# ----------------------------------------------------------------------------
# Sends the password-reset link (and, once implemented, 2FA codes). Email is "configured"
# when EMAIL_FROM and SMTP_PASSWORD are both set; otherwise the app logs mail in dev and
# warns in production. Set these up in the Aliyun console — see README-DEPLOY.md.
#
# SMTP host. Mainland China: smtpdm.aliyun.com. Outside China use the regional host, e.g.
# smtpdm-ap-southeast-1.aliyun.com (Singapore). Must match your Direct Mail region.
SMTP_HOST="smtpdm.aliyun.com"
# 465 = SSL (recommended), or 587 / 80 / 25 for STARTTLS.
SMTP_PORT="465"
# The verified Aliyun sender address (发信地址). Also used as the SMTP login username.
EMAIL_FROM=""
# Optional From display name (defaults to the app title).
EMAIL_FROM_NAME=""
# The SMTP password you set for that sender address in the Aliyun console (NOT your
# Aliyun account password). Leave SMTP_USER empty to log in as EMAIL_FROM.
SMTP_USER=""
SMTP_PASSWORD=""

# ----------------------------------------------------------------------------
# Database (Prisma / PostgreSQL)
# ----------------------------------------------------------------------------
# Local dev example. In Docker Compose this points at the `db` service host.
DATABASE_URL="postgresql://postgres:password@localhost:5432/shbs-peer-tutoring-website"

# Postgres container credentials (used by docker-compose `db` service in Phase 5).
# Keep these consistent with DATABASE_URL.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="shbs-peer-tutoring-website"

# ----------------------------------------------------------------------------
# Deployment (Docker Compose + Caddy)
# ----------------------------------------------------------------------------
# Public domain Caddy serves and auto-issues a Let's Encrypt cert for.
# Its DNS A record must point at the server before first start.
DOMAIN="tutoring.example.edu"

# Prebuilt app image pulled from GHCR (built by .github/workflows/docker-build.yml).
# Replace OWNER with your GitHub org/user (lowercase). Used by docker-compose.yml.
APP_IMAGE="ghcr.io/OWNER/shbs-peer-tutoring-website:latest"

# Note: in docker-compose.yml the app's DATABASE_URL is derived from POSTGRES_*
# (host "db"), and AUTH_URL=https://$DOMAIN + AUTH_TRUST_HOST=true are set there.

