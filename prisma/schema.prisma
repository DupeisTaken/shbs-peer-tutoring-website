// Prisma schema for the SHBS peer-tutoring management app.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Auth (NextAuth / Auth.js — Credentials provider, JWT sessions)
//
// Sign-in is email + password (verified server-side; see src/server/auth). We use
// JWT sessions (role + tutorId are resolved at sign-in and carried in the token), so
// no adapter `Session`/`Account`/`VerificationToken` tables are needed. Only `User`
// is persisted. A future email-based 2FA second factor plugs in via the scaffolding
// at the bottom of this file (`EmailVerificationCode`) — not yet implemented.
// ----------------------------------------------------------------------------

enum Role {
  /// Read-only access to the admin area, with personal/contact info masked. Cannot mutate.
  VIEWER
  /// Crew-only login: reaches only the /patrol portal (no admin or tutor area). Created via a
  /// CREW registration code; crew membership/lifecycle lives on `User.crewStatus`.
  CREW
  TUTOR
  COORDINATOR
  ADMIN
  /// Leader of the admins (singleton). Outranks ADMIN: the only role that can promote/demote
  /// admins or transfer leadership. Bootstrapped as the first AUTH_BOOTSTRAP_ADMIN_EMAILS entry.
  HEAD
}

model User {
  id    String  @id @default(cuid())
  name  String?
  /// Login identifier. Also the address future email-based 2FA codes are sent to.
  email String  @unique

  /// Account username — an alternate sign-in identifier (sign in with username OR email) and the
  /// account's stable handle shown across the admin area. Every account has one: for a linked
  /// tutor it mirrors `Tutor.username`; otherwise it's derived from the name/email. Unique across
  /// both `User` and `Tutor` (see src/server/auth/username.ts). Nullable only to allow lazy
  /// backfill of pre-existing rows — the app assigns one on sign-in / creation.
  username String? @unique

  /// scrypt password hash (see src/server/auth/password.ts). Null until a password is set.
  passwordHash String?

  /// True for auto-provisioned accounts that signed in with the shared default password —
  /// the first-login onboarding forces a real password (and email) before the dashboard.
  mustChangePassword Boolean @default(false)

  /// SCAFFOLDING for future email-based 2FA — see src/server/auth/two-factor.ts.
  /// When true, an emailed one-time code will be required as a second factor at
  /// sign-in. Not yet enforced anywhere.
  twoFactorEnabled Boolean @default(false)

  /// Set when the user completes first-login onboarding (`/onboarding/email`): they
  /// confirm the contact email their sign-in codes go to (email-2FA setup is scaffolded).
  /// Null = onboarding not done yet; the tutor shell routes them to the gate.
  emailVerifiedAt DateTime?

  role Role @default(TUTOR)

  /// Assigned translator: may edit UI translations on /localization even without an admin role.
  canTranslate Boolean @default(false)

  /// Crew membership lifecycle (walks the rooms and records headcounts at /patrol to validate
  /// tutor attendance). Null = not a crew member. ACTIVE = can patrol; OPTED_OUT = left (approved
  /// opt-out); INACTIVE = soft-removed by an admin (revertible). Independent of the role — a tutor
  /// can also be crew (role TUTOR + crewStatus ACTIVE); a crew-only login is role CREW. Crew
  /// service hours (0.5h per patrol) are accounted separately from tutoring hours.
  crewStatus CrewStatus?

  /// Grade level (G-number) for crew-only logins (tutors keep grade on their Tutor record). Drives
  /// the class-of year in the username suffix. Null for non-crew / unknown.
  gradeLevel Int?

  /// Who an observer is (self-registered read-only VIEWER): a free-text affiliation like
  /// "Parent of Jane Doe" or "Math faculty". Null for staff/non-observer accounts.
  affiliation String?

  /// Admin-flagged suspension (e.g. a suspicious observer): when set, the account can sign in but
  /// only sees a suspended notice + appeal form — all other access is blocked. Cleared on reinstate.
  suspendedAt     DateTime?
  suspendedReason String?

  /// Patrols this user (as a crew member) submitted, and their crew opt-out/reentry requests.
  patrols           Patrol[]
  crewStatusRequests CrewStatusRequest[]
  /// Appeals this user filed after being suspended.
  appeals           AccountAppeal[]

  // Optional link to the domain Tutor record (matched by email at first sign-in).
  tutor   Tutor?  @relation(fields: [tutorId], references: [id])
  tutorId String? @unique

  /// SCAFFOLDING — future email 2FA codes (see EmailVerificationCode). Unused for now.
  verificationCodes EmailVerificationCode[]

  /// SCAFFOLDING — forgot-password reset tokens (see PasswordResetToken).
  passwordResets PasswordResetToken[]

  // Announcements this user (admin) broadcast, and the ones they've acknowledged.
  announcements    Announcement[]    @relation("AnnouncementAuthor")
  announcementAcks AnnouncementAck[]
  // Disciplinary cards this user (admin) reviewed (flagged valid/invalid).
  cardReviews      DisciplinaryCard[] @relation("CardReviewer")
  // Policy documents this user (admin) last edited.
  policyEdits      PolicyDocument[]   @relation("PolicyEditor")
  // In-app notifications addressed to this user.
  notifications    Notification[]

  createdAt DateTime @default(now())
}

/// An available UI language. Built-in locales (en/zh/es) ship with bundled JSON; translators can
/// add more here (their strings come from MessageOverride rows, English-fallback). `sortOrder`
/// drives the language picker order (admins reorder). Built-ins are merged in even without a row.
model Language {
  code      String   @id
  label     String
  sortOrder Int      @default(0)
  builtIn   Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// A per-string override of a UI translation, edited in-app on /localization. One row per
/// (locale, dot-path key); deep-merged over the bundled messages JSON at request time
/// (see src/i18n/request.ts), so it white-labels/translates any string without a redeploy.
model MessageOverride {
  id            String   @id @default(cuid())
  locale        String
  key           String
  value         String
  updatedByName String?
  updatedAt     DateTime @updatedAt

  @@unique([locale, key])
  @@index([locale])
}

/// Optional program modules a HEAD can switch off to fit a different program (extend usability).
/// QUARTER_SYSTEM is a *mode*, not a disable: enabled = quarters (Q1–Q4), disabled = semesters
/// (S1/S2) at the same refresh machinery. Everything else is a soft hide+block when disabled.
enum ProgramFeatureKey {
  CREW
  DISCIPLINE
  MEETINGS
  INTERVIEWS
  SERVICE_HOURS
  QUARTER_SYSTEM
  /// Public, email-validated viewer self-registration (read-only VIEWER accounts).
  VIEWER_SIGNUP
  /// Email-based two-factor: the sign-in second factor (scaffolded) + the emailed code required
  /// on a password change. Off lets a program with no email configured still change passwords.
  EMAIL_2FA
}

/// One row per optional module. `enabled` is the effective value; `pendingEnabled` is a staged
/// change a HEAD made that activates at the next program refresh (null = no pending change).
/// Missing row = default enabled (a fresh deployment has every module on). HEAD-only writes.
model ProgramFeature {
  key            ProgramFeatureKey @id
  enabled        Boolean           @default(true)
  pendingEnabled Boolean?
  updatedByName  String?
  updatedAt      DateTime          @updatedAt
}

/// An in-progress public observer self-registration (no admin code needed — gated only by email
/// validation). Holds the entered identity + a hashed email-verification code; on verification +
/// password it becomes a read-only VIEWER login. Rate-limited at the router. One row per email.
/// See src/server/auth/viewer-signup.ts.
model ViewerSignup {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  affiliation   String
  codeHash      String
  codeExpiresAt DateTime
  attempts      Int       @default(0)
  verifiedAt    DateTime?
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

/// Review state of a suspended user's reinstatement appeal.
enum AppealState {
  PENDING
  APPROVED
  DENIED
}

/// An appeal a suspended user files to request reinstatement; an admin decides on /admin/users.
model AccountAppeal {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  message       String
  state         AppealState @default(PENDING)
  decidedByName String?
  decidedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([userId])
  @@index([state])
}

/// An audit record of an admin mutation, with optional typed data to revert it. Actor
/// id/name are denormalised so history survives user deletion. See src/server/audit/log.ts.
model AuditLog {
  id        String    @id @default(cuid())
  userId    String?
  userName  String?
  action    String // human-readable, e.g. "Deleted course \"Physics\""
  entity    String // e.g. "Subject"
  entityId  String?
  /// Typed payload describing how to undo this action; null = not auto-revertible.
  undoData  Json?
  undone    Boolean   @default(false)
  undoneAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

/// A lightweight in-app notification for any user (tutor / coordinator / admin).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  /// Optional in-app link the notification points to (e.g. "/dashboard").
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// ----------------------------------------------------------------------------
// Domain
// ----------------------------------------------------------------------------

enum Quarter {
  Q1
  Q2
  Q3
  Q4
}

/// Lifecycle state of a tutor. ACTIVE tutors are eligible for pairings/attendance; the other
/// three are "inactive" (read-only program access + own history). GRADUATED is set automatically
/// when the program advances into Q4 for G12+; OPTED_OUT is set when an approved opt-out request
/// is processed; ARCHIVED is the generic admin/crew deactivation (e.g. unavailable at rollover).
enum TutorStatus {
  ACTIVE
  /// Awaiting the tutor's start-of-term activation: after a semester refresh, continuing tutors are
  /// set PENDING and must reactivate (choose available -> ACTIVE, or opt out -> OPTED_OUT) from
  /// their own page. Treated as inactive (read-only) until they choose.
  PENDING
  GRADUATED
  OPTED_OUT
  ARCHIVED
}

/// Lifecycle of a tutee record. Public self-signups start PENDING and are reviewed by
/// an admin (who assigns them to a tutor); admins create tutees as ACTIVE directly.
enum TuteeStatus {
  PENDING
  ACTIVE
  INACTIVE
}

/// The tutor's own status for a session (whether the session was held).
enum SessionTutorStatus {
  PRESENT
  RESCHEDULED
  EXTRA
  TUTOR_ABSENT
}

/// A single tutee's attendance at a held session.
enum TuteeAttendanceStatus {
  PRESENT
  EXCUSED_ABSENT
  UNEXCUSED_ABSENT
}

/// Tutor meeting attendance: P / EA / UA / X.
enum MeetingAttendanceStatus {
  PRESENT // P
  EXCUSED_ABSENT // EA
  UNEXCUSED_ABSENT // UA
  EXEMPT // X
}

/// Direction of a per-tutor monthly service-hour adjustment.
enum AdjustmentType {
  PUNISHMENT // subtracts hours
  EXTRA // adds hours
}

/// Admin-managed difficulty/track levels (e.g. AP / Honors / Standard). `apScored` marks a
/// level whose courses can carry an AP exam score — it gates the AP-score field on tutor
/// applications. `rank` orders the catalogue.
model SubjectLevel {
  id        String   @id @default(cuid())
  name      String   @unique
  rank      Int      @default(0)
  apScored  Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  subjects Subject[]
}

/// A program period = one quarter of a school year. Exactly one is `active` at a time (the
/// "current period"); refreshing creates + activates the next quarter's term. See src/lib/period.ts.
model Term {
  id         String         @id @default(cuid())
  schoolYear String // "25-26"
  quarter    Quarter
  name       String // e.g. "25-26 Q3"
  startDate  DateTime?
  endDate    DateTime?
  active     Boolean        @default(false)
  pairings   Pairing[]
  meetings   TutorMeeting[]
  patrols    Patrol[]
  createdAt  DateTime       @default(now())

  @@unique([schoolYear, quarter])
}

model Tutor {
  id          String   @id @default(cuid())
  /// Split name. `englishName` is kept as the canonical display name (= "First Last")
  /// so the many places that render it don't change.
  firstName   String?
  lastName    String?
  englishName String
  /// Free-text alternative name(s) — full Unicode (e.g. 简体中文 / 漢字 / etc.). Display only;
  /// shown alongside englishName. No charset restriction is applied anywhere.
  alternativeNames String?
  /// Login handle — default is first initial + full last name (e.g. "jsmith"), lowercased.
  /// Unique; lets a tutor sign in with username OR email. Resolved to the User via the
  /// `user` relation in the Credentials authorize().
  username    String?  @unique
  /// Work/school email. Used to link the Tutor to a User account at first sign-in
  /// (User.email is matched against this).
  email       String?  @unique
  /// Lifecycle state (see TutorStatus). ACTIVE = eligible for pairings/attendance; the rest are
  /// inactive (read-only). Replaces the former `active` boolean.
  status      TutorStatus @default(ACTIVE)
  /// School grade (e.g. 9–12), self-reported by the tutor. Increments by one when the program
  /// refreshes across a school year; G12 tutors graduate at that point. Class-of year is derived
  /// from this + the active school year (tutors can't edit the derived year). See src/lib/period.ts.
  gradeLevel  Int?
  createdAt   DateTime @default(now())

  user                 User?
  pairings             Pairing[]
  sessions             Session[]
  adjustments          ServiceHourAdjustment[]
  meetingAttendances   MeetingAttendance[]
  availabilities       TutorAvailability[]
  interviewAssignments InterviewAssignment[]
  statusRequests       TutorStatusRequest[]
  sessionFlags         SessionFlag[]
  registrationCodes    RegistrationCode[]
  // Disciplinary cards this tutor issued, interview votes they cast, and applications
  // they decided as head interviewer.
  issuedCards          DisciplinaryCard[]    @relation("CardIssuer")
  interviewVotes       InterviewVote[]
  applicationDecisions TutorApplication[]    @relation("AppDecider")

  @@index([status])
}

/// A tutor-initiated lifecycle request, reviewed by an admin.
///   OPT_OUT  — leave the program. A one-week cooldown applies: `eligibleAt` = createdAt + 7d,
///              and an admin can't approve before then. The tutor may RECALL it during the wait.
///              On approval the tutor becomes OPTED_OUT (their tutees are re-queued by the admin).
///   REENTRY  — an OPTED_OUT tutor asks to return. No cooldown; on approval they become ACTIVE.
/// Exactly one PENDING request per tutor at a time (enforced in the router).
model TutorStatusRequest {
  id          String                  @id @default(cuid())
  tutorId     String
  tutor       Tutor                   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  kind        TutorRequestKind
  state       TutorRequestState       @default(PENDING)
  reason      String?
  /// Earliest an admin may approve (opt-out cooldown). Null for reentry (immediate).
  eligibleAt  DateTime?
  createdAt   DateTime                @default(now())
  /// When the request left PENDING (approved / denied / recalled), plus who acted.
  resolvedAt  DateTime?
  resolvedById String?
  resolvedByName String?

  @@index([tutorId])
  @@index([state])
}

enum TutorRequestKind {
  OPT_OUT
  REENTRY
}

enum TutorRequestState {
  PENDING
  RECALLED
  APPROVED
  DENIED
}

/// A single-use 6-digit code that authorizes someone to self-register a tutor account at
/// /register. The plaintext `code` is stored so admins can re-display it on the registration-codes
/// menu (it's not secret long-term — single-use + a 7-day expiry bound its value). Codes are issued
/// by admins/coordinators (or generated when a tutor application is ACCEPTED) and handed to the
/// intended person. Optional bindings:
///   email         — registrant must verify this exact address.
///   tutorId       — links registration to an existing roster Tutor (instead of creating one).
///   applicationId — provenance: the accepted application this code was issued for.
/// `pendingEmail`/`emailCode*` hold the in-progress email-verification step (a separate emailed
/// 6-digit code the registrant types back, stored hashed); `emailVerifiedAt` is stamped on confirm.
/// What kind of account a registration code provisions on completion.
enum RegistrationCodeKind {
  TUTOR
  CREW
}

model RegistrationCode {
  id            String    @id @default(cuid())
  /// The 5-character Steam-style code (plaintext, for admin re-display). Nullable only to migrate
  /// legacy rows. See src/server/auth/code.ts.
  code          String?   @unique
  /// Whether redeeming this code creates a TUTOR account (default) or a crew-only CREW account.
  kind          RegistrationCodeKind @default(TUTOR)
  /// Optional binding: the email the registrant must use/verify.
  email         String?
  /// Optional link to an existing roster Tutor this registration completes.
  tutorId       String?
  tutor         Tutor?    @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  /// Optional provenance: the accepted TutorApplication that triggered this code.
  applicationId String?
  /// Optional provenance: the accepted CrewApplication that triggered this code. Revoking the code
  /// reverts that application to PENDING (so the request becomes visible/actionable again).
  crewApplicationId String?
  /// Human label for the admin menu, e.g. "for Jane Doe (G11)".
  label         String?
  issuedById    String?
  issuedByName  String?
  expiresAt     DateTime
  /// Email-verification sub-state for the in-progress registration.
  pendingEmail       String?
  emailCodeHash      String?
  emailCodeExpiresAt DateTime?
  emailCodeAttempts  Int       @default(0)
  emailVerifiedAt    DateTime?
  /// Consumption: single-use.
  usedAt        DateTime?
  usedByUserId  String?
  /// Verification attempt counter on the registration code itself (rate-limit guard).
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([tutorId])
  @@index([applicationId])
  @@index([crewApplicationId])
  @@index([usedAt])
}

/// A subject offered for tutoring. The catalog is managed by admins; tutees pick a
/// first (required) and optional second choice from it on the public signup form.
model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Difficulty/track level from the admin-managed catalogue (SubjectLevel). Optional.
  levelId   String?
  level     SubjectLevel? @relation(fields: [levelId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  firstChoiceTutees  Tutee[]                    @relation("TuteeFirstChoice")
  secondChoiceTutees Tutee[]                    @relation("TuteeSecondChoice")
  applicationIntents ApplicationSubjectIntent[]
}

model Tutee {
  id          String      @id @default(cuid())
  englishName String
  email       String?
  phone       String?
  /// Free-text "how can we reach you?" captured on the public signup form (required there).
  preferredContact String?
  gradeLevel  String?
  notes       String?
  status      TuteeStatus @default(ACTIVE)

  // Subject preferences chosen on the signup form (first required, second optional).
  firstChoiceId  String?
  firstChoice    Subject? @relation("TuteeFirstChoice", fields: [firstChoiceId], references: [id])
  secondChoiceId String?
  secondChoice   Subject? @relation("TuteeSecondChoice", fields: [secondChoiceId], references: [id])

  // Electronic signature: the tutee types their name to agree to the rulebook.
  signedRulebook Boolean   @default(false)
  signatureName  String?
  signedAt       DateTime?

  createdAt DateTime @default(now())
  /// Optimistic-concurrency token: high-risk mutations pass the value they read and are
  /// rejected if it changed (another coordinator acted first). See src/server/concurrency.ts.
  updatedAt DateTime @updatedAt

  availabilities TuteeAvailability[]
  pairings       PairingTutee[]
  sessions       SessionTutee[]
  cards          DisciplinaryCard[]
  removalRequests TuteeRemovalRequest[]

  @@index([status])
}

/// A request to remove a tutee from the program, raised by their tutor (the person who knows the
/// tutee stopped attending / left) and reviewed by an admin — mirroring the tutor opt-out flow.
/// Recallable while PENDING. Approving sets the tutee INACTIVE and detaches them from the pairing;
/// denying just closes it. `pairingId`/`requestedByTutorId` are scalar (no relation) — names are
/// resolved in the admin query — so adding this needs no edits to Pairing/Tutor.
model TuteeRemovalRequest {
  id        String            @id @default(cuid())
  tuteeId   String
  tutee     Tutee             @relation(fields: [tuteeId], references: [id], onDelete: Cascade)
  /// Why removal was raised: VOLUNTARY (the tutee asked to opt out, relayed by their tutor — a
  /// 7-day recall window then auto-approves) or PUNISHMENT (auto-removed immediately when the
  /// tutee's disciplinary standing hits the removal threshold).
  kind      TuteeRemovalKind  @default(VOLUNTARY)
  /// The pairing the tutor relayed the opt-out from (context). Null for PUNISHMENT.
  pairingId String?
  /// The tutor who relayed the opt-out (scalar; resolved to a name in the admin query). Null for
  /// PUNISHMENT (no tutor action — the system raises it).
  requestedByTutorId String?
  reason    String?
  state     TuteeRequestState @default(PENDING)
  /// VOLUNTARY opt-out only: earliest the request auto-approves (createdAt + 7-day recall window).
  /// The tutor can recall, or an admin cancel, before this. Null for PUNISHMENT (immediate).
  eligibleAt DateTime?
  /// The active period (e.g. "26-27 Q1") stamped when the removal finalized. A PUNISHMENT removal
  /// flags same-identity re-signups for that period (see the signup queue). Null until finalized.
  removedPeriodKey String?
  createdAt DateTime          @default(now())
  /// When the request left PENDING (approved / denied / recalled), plus who acted.
  resolvedAt    DateTime?
  resolvedById  String?
  resolvedByName String?

  @@index([tuteeId])
  @@index([state])
}

enum TuteeRequestState {
  PENDING // opt-out awaiting its recall window
  APPROVED // finalized removal in effect (tutee INACTIVE)
  DENIED // admin cancelled an in-flight opt-out (no removal)
  RECALLED // tutor recalled their opt-out (no removal)
  REINSTATED // admin reversed a finalized removal (tutee active again; any ban lifted)
}

enum TuteeRemovalKind {
  VOLUNTARY
  PUNISHMENT
}

/// A reusable named time slot (e.g. "Mon 3:30–4:30"). The catalog is admin-managed.
/// Tutors and tutees mark which slots they are available for; a Pairing may reference
/// one as its default/reference time. Slots are reference-only — actual session times
/// are still entered on each attendance submission.
model TimeSlot {
  id        String   @id @default(cuid())
  label     String
  dayOfWeek Int // 1 = Monday .. 7 = Sunday
  startMin  Int // minutes from midnight
  endMin    Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  pairings            Pairing[]
  tutorAvailabilities TutorAvailability[]
  tuteeAvailabilities TuteeAvailability[]

  @@index([dayOfWeek, startMin])
}

/// Join: the time slots a tutor has marked themselves available for.
model TutorAvailability {
  tutorId String
  tutor   Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  slotId  String
  slot    TimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@id([tutorId, slotId])
  @@index([slotId])
}

/// Join: the time slots a tutee selected as available on the signup form.
model TuteeAvailability {
  tuteeId String
  tutee   Tutee    @relation(fields: [tuteeId], references: [id], onDelete: Cascade)
  slotId  String
  slot    TimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@id([tuteeId, slotId])
  @@index([slotId])
}

model Room {
  id        String    @id @default(cuid())
  name      String    @unique
  /// The crew's patrol sequence — rooms are visited in ascending `patrolOrder` on /patrol.
  /// Admin-customizable; null sorts last. Default 0 so new rooms group at the front until ordered.
  patrolOrder Int     @default(0)
  pairings  Pairing[]
  createdAt DateTime  @default(now())

  unavailabilities RoomUnavailability[]
  sessions         Session[]
  patrolObservations PatrolObservation[]
}

/// A recurring weekly period during which a room cannot be used (e.g. another class).
/// Surfaced on the room grid so coordinators don't schedule pairings into a blocked slot.
model RoomUnavailability {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 1 = Monday .. 7 = Sunday
  startMin  Int // minutes from midnight
  endMin    Int
  reason    String?
  createdAt DateTime @default(now())

  @@index([roomId])
}

model Pairing {
  id        String   @id @default(cuid())
  subject   String
  dayOfWeek Int // 1 = Monday .. 7 = Sunday
  startMin  Int // minutes from midnight
  endMin    Int
  createdAt DateTime @default(now())

  tutorId    String
  tutor      Tutor     @relation(fields: [tutorId], references: [id])
  termId     String
  term       Term      @relation(fields: [termId], references: [id])
  roomId     String?
  room       Room?     @relation(fields: [roomId], references: [id])
  // Optional reference to the catalog time slot this pairing was scheduled into.
  // Reference-only: the day/start/end above remain the source of truth.
  timeSlotId String?
  timeSlot   TimeSlot? @relation(fields: [timeSlotId], references: [id])

  tutees   PairingTutee[]
  sessions Session[]

  @@index([tutorId])
  @@index([termId])
}

/// Join table: the tutees rostered on a pairing.
model PairingTutee {
  pairingId String
  pairing   Pairing @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  tuteeId   String
  tutee     Tutee   @relation(fields: [tuteeId], references: [id], onDelete: Cascade)

  @@id([pairingId, tuteeId])
  @@index([tuteeId])
}

/// One attendance submission for a pairing meeting.
model Session {
  id     String             @id @default(cuid())
  date   DateTime
  /// The tutor's own status (did the session happen?). Tutee attendance is per-tutee on
  /// SessionTutee. A reason is captured when the tutor was absent.
  tutorStatus       SessionTutorStatus @default(PRESENT)
  tutorAbsentReason String?

  // Start/end captured at submission (defaults from the pairing, may be overridden).
  startMin Int
  endMin   Int

  // Five 1-5 ratings (nullable when not applicable, e.g. an absence).
  ratingPreparedness  Int?
  ratingParticipation Int?
  ratingUnderstanding Int?
  ratingBehavior      Int?
  ratingProgress      Int?

  comments String?

  // Derived, computed server-side at submit time and stored on the row.
  month       String // "YYYY-MM"
  // Program period this session counts toward (stamped from the pairing's term). Service hours
  // are scoped by semester (derived from the quarter); see src/lib/period.ts.
  schoolYear  String // "25-26"
  quarter     Quarter
  durationMin Int
  shFactor    Int
  shCount     Float

  createdAt DateTime @default(now())

  // When a tutor runs several courses in one combined block, each course gets its own Session
  // sharing this id (the primary session's id). The block's clock time is counted once — on the
  // primary session — so merged siblings carry shCount 0. Null for a standalone session.
  mergeGroupId String?

  pairingId String
  pairing   Pairing @relation(fields: [pairingId], references: [id])
  tutorId   String
  tutor     Tutor   @relation(fields: [tutorId], references: [id])

  /// The room the session actually ran in (captured at submit; defaults to the pairing's room).
  /// Used to match crew patrol observations to this session. Null when `online` or unrecorded.
  actualRoomId String?
  actualRoom   Room?   @relation(fields: [actualRoomId], references: [id])
  /// The tutor held this session online (no physical room) — excluded from crew validation.
  online       Boolean @default(false)

  tutees SessionTutee[]
  // Disciplinary cards requested via this attendance submission's survey.
  cards  DisciplinaryCard[]
  // Crew-vs-self-report discrepancy flags raised against this session.
  flags  SessionFlag[]

  @@index([tutorId, month])
  @@index([tutorId, schoolYear, quarter])
  @@index([schoolYear, quarter])
  @@index([pairingId])
  @@index([mergeGroupId])
  @@index([actualRoomId])
}

// ----------------------------------------------------------------------------
// Crew patrols — a roaming team records room headcounts to validate tutor attendance.
//
// A crew member walks the rooms (in Room.patrolOrder) and records how many students are in each
// (Headcount bucket) with a timestamp. One full sweep = one Patrol (credits 0.5h, accounted
// separately from tutoring hours). When an observation shows FEWER students than the tutor marked
// present for a session in that room/time, a SessionFlag is auto-raised for admin review.
// ----------------------------------------------------------------------------

/// Crew membership lifecycle (on User.crewStatus). Null (no value) = not a crew member.
enum CrewStatus {
  ACTIVE // current crew member; can patrol
  OPTED_OUT // left the crew (approved opt-out); read-only patrol portal, may request reentry
  INACTIVE // soft-removed by an admin; revertible
}

/// Review state of a public "apply to be crew" submission. Accepting issues a CREW registration code.
enum CrewApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// A public application to join the crew (no login is created — mirrors /signup & /tutor-signup).
/// An admin reviews it on /admin/crew; accepting issues a CREW registration code bound to the email.
model CrewApplication {
  id               String                @id @default(cuid())
  name             String
  email            String
  gradeLevel       Int?
  preferredContact String?
  message          String?
  status           CrewApplicationStatus @default(PENDING)
  decisionComment  String?
  decidedByName    String?
  decidedAt        DateTime?
  createdAt        DateTime              @default(now())

  @@index([status])
}

/// Kind of a crew lifecycle request a member initiates from /patrol.
enum CrewRequestKind {
  OPT_OUT
  REENTRY
}

/// State of a crew opt-out/reentry request.
enum CrewRequestState {
  PENDING
  APPROVED
  DENIED
  RECALLED
}

/// A crew member's opt-out (with a recall cooldown) or reentry request, approved by an admin —
/// mirrors TutorStatusRequest. Opt-out approval sets crewStatus OPTED_OUT; reentry → ACTIVE.
model CrewStatusRequest {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          CrewRequestKind
  state         CrewRequestState @default(PENDING)
  /// Opt-out becomes approvable only after this cooldown; the member can recall until then.
  eligibleAt    DateTime?
  reason        String?
  decidedByName String?
  decidedAt     DateTime?
  createdAt     DateTime         @default(now())

  @@index([userId])
  @@index([state])
}

/// Observed students in a room: an exact 0–3 or "4 or more". 4+ is treated as ≥4 in comparisons.
enum Headcount {
  ZERO
  ONE
  TWO
  THREE
  FOUR_PLUS
}

/// One crew sweep. Credits 0.5h to the crew member on submit.
model Patrol {
  id          String   @id @default(cuid())
  crewUserId  String
  crewUser    User     @relation(fields: [crewUserId], references: [id], onDelete: Cascade)
  termId      String?
  term        Term?    @relation(fields: [termId], references: [id])
  /// Service hours credited for this patrol (0.5 by policy; stored so the rate can change later).
  hours       Float    @default(0.5)
  note        String?
  createdAt   DateTime @default(now())

  observations PatrolObservation[]

  @@index([crewUserId])
  @@index([termId])
}

/// One room's headcount during a patrol, with the time it was observed.
model PatrolObservation {
  id         String    @id @default(cuid())
  patrolId   String
  patrol     Patrol    @relation(fields: [patrolId], references: [id], onDelete: Cascade)
  roomId     String
  room       Room      @relation(fields: [roomId], references: [id])
  headcount  Headcount
  observedAt DateTime  @default(now())

  @@index([roomId, observedAt])
  @@index([patrolId])
}

/// Review state of a crew-vs-self-report discrepancy. Auto-raised PENDING; an admin decides.
enum SessionFlagState {
  PENDING
  DISMISSED // a false alarm / acceptable — closed, no effect
  WARNED // a warning recorded against the tutor
  PENALIZED // a service-hour deduction applied
  ESCALATED // escalated to tutor removal/opt-out review
}

/// A discrepancy between the crew's headcount and a tutor's attendance entry (the crew saw fewer
/// students than the tutor marked present). Surfaced as an admin review request, like the removal
/// queues. One per session, kept in sync with the evidence by `syncSessionFlag`.
model SessionFlag {
  id          String           @id @default(cuid())
  sessionId   String           @unique
  session     Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tutorId     String
  tutor       Tutor            @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  /// Snapshot of the discrepancy: how many the tutor marked present vs. the crew's lowest count.
  expected    Int
  observed    Int
  state       SessionFlagState @default(PENDING)
  decisionNote String?
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?
  resolvedById String?
  resolvedByName String?

  @@index([state])
  @@index([tutorId])
}

/// Join table: the tutees covered by a particular attendance submission.
model SessionTutee {
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tuteeId   String
  tutee     Tutee   @relation(fields: [tuteeId], references: [id])
  /// This tutee's attendance at the session; a reason is captured when excused-absent.
  status        TuteeAttendanceStatus @default(PRESENT)
  absenceReason String?

  @@id([sessionId, tuteeId])
  @@index([tuteeId])
}

model TutorMeeting {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  createdAt DateTime @default(now())

  termId String?
  term   Term?   @relation(fields: [termId], references: [id])

  attendances MeetingAttendance[]
}

model MeetingAttendance {
  id     String                  @id @default(cuid())
  status MeetingAttendanceStatus
  /// Optional note — the tutor's reason when they self-excuse, or an admin note.
  reason String?
  /// Set when the tutor self-excused (pre-meeting, ≥30 min before) from their dashboard. Non-null
  /// ⟺ a tutor-submitted excuse; lets the coordination page flag it. Admin-set attendance leaves it null.
  excusedAt DateTime?

  meetingId String
  meeting   TutorMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  tutorId   String
  tutor     Tutor        @relation(fields: [tutorId], references: [id])

  @@unique([meetingId, tutorId])
  @@index([tutorId])
}

/// Per-tutor, per-month service-hour adjustment feeding the monthly total
/// (monthly total = SUM(shCount) - PUNISHMENT amounts + EXTRA amounts).
model ServiceHourAdjustment {
  id         String         @id @default(cuid())
  month      String // "YYYY-MM"
  // Program period the adjustment counts toward (stamped from the active term at creation).
  schoolYear String // "25-26"
  quarter    Quarter
  type       AdjustmentType
  amount     Float
  reason     String?
  createdAt  DateTime       @default(now())

  tutorId String
  tutor   Tutor  @relation(fields: [tutorId], references: [id])

  @@index([tutorId, month])
  @@index([tutorId, schoolYear, quarter])
}

// ----------------------------------------------------------------------------
// Tutor applications + interview workflow
//
// Prospective tutors apply via the public form (no login is created). Admins assign up
// to three existing tutors as interviewers — one marked head — and the head schedules the
// interview time, which surfaces on each interviewer's dashboard.
// ----------------------------------------------------------------------------

enum TutorApplicationStatus {
  PENDING // submitted, awaiting interviewer assignment
  INTERVIEW // interviewers assigned / scheduling
  ACCEPTED
  REJECTED
}

model TutorApplication {
  id              String                 @id @default(cuid())
  name            String
  /// Contact email. SCAFFOLDING: future email-based 2FA / verification codes for the
  /// applicant would be sent here (see src/server/auth/two-factor.ts); not wired yet.
  email           String
  /// Free-text "how can we reach you?" captured on the public application form (required there).
  preferredContact String?
  contactVerified Boolean                @default(false)
  status          TutorApplicationStatus @default(PENDING)
  /// Interview time, coordinated by the head interviewer.
  interviewAt     DateTime?
  /// Head interviewer's final decision: recorded on the head's page with a brief comment.
  /// The per-panelist tally lives in `votes`; `status` reflects the outcome (ACCEPTED/REJECTED).
  decisionComment   String?
  decidedAt         DateTime?
  decidedByTutorId  String?
  decidedByTutor    Tutor?    @relation("AppDecider", fields: [decidedByTutorId], references: [id])
  createdAt       DateTime               @default(now())
  /// Optimistic-concurrency token (see src/server/concurrency.ts).
  updatedAt       DateTime               @updatedAt

  subjectIntents ApplicationSubjectIntent[]
  interviewers  InterviewAssignment[]
  votes         InterviewVote[]

  @@index([status])
}

/// One intended tutoring course on an application (max 3 enforced in the form/mutation),
/// with whether the applicant has taken it and the grade / AP score they received.
model ApplicationSubjectIntent {
  id            String           @id @default(cuid())
  applicationId String
  application   TutorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject          @relation(fields: [subjectId], references: [id])
  taken         Boolean          @default(false)
  grade         String? // class grade received, when taken
  /// Whether the applicant has an AP score for this (AP-tagged) subject.
  hasApScore    Boolean          @default(false)
  apScore       String? // AP score, only when hasApScore
  /// Whether the applicant self-studied this subject instead of taking the class.
  selfStudied   Boolean          @default(false)
  selfStudyNote String? // how they qualify / what they achieved, when selfStudied

  @@index([applicationId])
}

/// Join: a tutor assigned to interview an applicant. Exactly one per application is head.
model InterviewAssignment {
  applicationId String
  application   TutorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tutorId       String
  tutor         Tutor            @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  isHead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@id([applicationId, tutorId])
  @@index([tutorId])
}

/// One panelist's vote on an applicant after the demonstration (accept = simple majority
/// admits; the head breaks ties). The head reads the tally + comments before deciding.
model InterviewVote {
  applicationId String
  application   TutorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tutorId       String
  tutor         Tutor            @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  accept        Boolean
  comment       String?
  createdAt     DateTime         @default(now())

  @@id([applicationId, tutorId])
  @@index([tutorId])
}

model PolicyFile {
  id         String   @id @default(cuid())
  name       String
  path       String // stored file path or URL
  uploadedAt DateTime @default(now())
}

/// An editable policy document (e.g. the tutor / tutee handbooks). Body is Markdown, edited
/// in the admin area (/admin/policies) and seeded from the published handbooks.
model PolicyDocument {
  id String @id @default(cuid())
  /// Stable key, e.g. "tutor-policy" / "tutee-policy".
  slug String
  /// BCP-47-ish UI locale this version is written in (matches NEXT_LOCALE: "en", "zh", …).
  /// One row per (slug, locale); the "en" row is the fallback when a translation is missing.
  locale      String   @default("en")
  title       String
  body        String // Markdown
  version     String?
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("PolicyEditor", fields: [updatedById], references: [id])

  @@unique([slug, locale])
}

/// A point-in-time snapshot of a PolicyDocument, written each time an edit replaces an existing
/// version. Lets admins review/restore-from earlier copies of a handbook (see /admin/policies).
/// Actor name is denormalised so history survives user deletion.
model PolicyArchive {
  id             String   @id @default(cuid())
  slug           String
  locale         String
  title          String
  body           String // Markdown
  version        String?
  archivedByName String?
  archivedAt     DateTime @default(now())

  @@index([slug, locale, archivedAt])
}

// ----------------------------------------------------------------------------
// Discipline — tutee yellow/red cards (the "punishment" system in the policy)
//
// Tutors request cards via the attendance survey (source TUTOR, with a required reason),
// and the team rechecks each, flagging it VALID or INVALID. The system also auto-issues
// cards from attendance (source AUTO, e.g. unexcused absence -> red). Standing is derived
// from VALID cards: 3 yellows count as 1 red, and 2 reds = removal-pending. The escalation
// tally is computed (see src/lib/discipline.ts), not materialized, to avoid double counting.
// ----------------------------------------------------------------------------

enum CardColor {
  YELLOW
  RED
}

/// Where a card came from: a tutor's survey request, or automatic policy issuance.
enum CardSource {
  TUTOR
  AUTO
}

/// Team review state of a card. TUTOR cards start PENDING (await recheck); AUTO cards are
/// created VALID (rule-based) but can still be flagged INVALID on appeal.
enum CardReviewStatus {
  PENDING
  VALID
  INVALID
}

model DisciplinaryCard {
  id           String           @id @default(cuid())
  tuteeId      String
  tutee        Tutee            @relation(fields: [tuteeId], references: [id], onDelete: Cascade)
  color        CardColor
  source       CardSource       @default(TUTOR)
  /// Required justification: the tutor's comment, or the auto-issue reason.
  reason       String?
  reviewStatus CardReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?            @relation("CardReviewer", fields: [reviewedById], references: [id])
  // For TUTOR-sourced cards: who requested it and via which attendance submission.
  issuedByTutorId String?
  issuedByTutor   Tutor?        @relation("CardIssuer", fields: [issuedByTutorId], references: [id])
  sessionId       String?
  session         Session?      @relation(fields: [sessionId], references: [id])
  createdAt    DateTime         @default(now())
  /// Optimistic-concurrency token (see src/server/concurrency.ts).
  updatedAt    DateTime         @updatedAt

  @@index([tuteeId])
  @@index([reviewStatus])
}

// ----------------------------------------------------------------------------
// Announcements — broadcast by the team, shown to tutors on every login until acknowledged
// ----------------------------------------------------------------------------

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  /// Pinned announcements stay surfaced even after acknowledgement.
  pinned      Boolean  @default(false)
  active      Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("AnnouncementAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  acks AnnouncementAck[]

  @@index([active])
}

/// Records that a user dismissed/acknowledged an announcement (so it stops popping on login).
model AnnouncementAck {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ackedAt        DateTime     @default(now())

  @@id([announcementId, userId])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Emailed one-time codes (step-up / 2FA)
//
// `EmailVerificationCode` now backs the PASSWORD_CHANGE step-up flow (an emailed code is
// required to change a password while signed in — see src/server/auth/step-up.ts). The
// LOGIN_2FA second factor remains scaffolded only (src/server/auth/two-factor.ts); the
// email seam is src/server/email/sender.ts.
// ----------------------------------------------------------------------------

enum VerificationPurpose {
  LOGIN_2FA // emailed one-time code as a login second factor
  PASSWORD_RESET // forgot-password reset (see PasswordResetToken)
  PASSWORD_CHANGE // emailed step-up code required to change a password while signed in
  // Future: EMAIL_CHANGE, ...
}

/// A short-lived, single-use one-time code emailed to a user as a second factor.
/// Only the hash of the code is stored — never the plaintext.
model EmailVerificationCode {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    VerificationPurpose @default(LOGIN_2FA)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())

  @@index([userId])
}

/// A short-lived, single-use password-reset token for the forgot-password flow.
/// Only the token *hash* is stored — the plaintext goes in the emailed reset link.
/// The token logic (issue/verify) is implemented in src/server/auth/password-reset.ts;
/// email DELIVERY is scaffolded only (no provider wired up — see src/server/email/sender.ts).
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
