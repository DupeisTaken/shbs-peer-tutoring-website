// Prisma schema for the SHBS peer-tutoring management app.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Auth (NextAuth / Auth.js — Credentials provider, JWT sessions)
//
// Sign-in is email + password (verified server-side; see src/server/auth). We use
// JWT sessions (role + tutorId are resolved at sign-in and carried in the token), so
// no adapter `Session`/`Account`/`VerificationToken` tables are needed. Only `User`
// is persisted. A future email-based 2FA second factor plugs in via the scaffolding
// at the bottom of this file (`EmailVerificationCode`) — not yet implemented.
// ----------------------------------------------------------------------------

enum Role {
  TUTOR
  COORDINATOR
  ADMIN
}

model User {
  id    String  @id @default(cuid())
  name  String?
  /// Login identifier. Also the address future email-based 2FA codes are sent to.
  email String  @unique

  /// scrypt password hash (see src/server/auth/password.ts). Null until a password is set.
  passwordHash String?

  /// SCAFFOLDING for future email-based 2FA — see src/server/auth/two-factor.ts.
  /// When true, an emailed one-time code will be required as a second factor at
  /// sign-in. Not yet enforced anywhere.
  twoFactorEnabled Boolean @default(false)

  role Role @default(TUTOR)

  // Optional link to the domain Tutor record (matched by email at first sign-in).
  tutor   Tutor?  @relation(fields: [tutorId], references: [id])
  tutorId String? @unique

  /// SCAFFOLDING — future email 2FA codes (see EmailVerificationCode). Unused for now.
  verificationCodes EmailVerificationCode[]

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// Domain
// ----------------------------------------------------------------------------

enum Quarter {
  Q3
  Q4
}

/// Lifecycle of a tutee record. Public self-signups start PENDING and are reviewed by
/// an admin (who assigns them to a tutor); admins create tutees as ACTIVE directly.
enum TuteeStatus {
  PENDING
  ACTIVE
  INACTIVE
}

/// Status of a single attendance submission.
enum AttendanceStatus {
  PRESENT
  RESCHEDULED
  EXTRA_SESSION
  TUTOR_ABSENT
  TUTEE_ABSENT_EXCUSED
  TUTEE_ABSENT_UNEXCUSED
}

/// Tutor meeting attendance: P / EA / UA / X.
enum MeetingAttendanceStatus {
  PRESENT // P
  EXCUSED_ABSENT // EA
  UNEXCUSED_ABSENT // UA
  EXEMPT // X
}

/// Direction of a per-tutor monthly service-hour adjustment.
enum AdjustmentType {
  PUNISHMENT // subtracts hours
  EXTRA // adds hours
}

model Term {
  id        String         @id @default(cuid())
  quarter   Quarter
  name      String // e.g. "2025-2026 Q3"
  startDate DateTime?
  endDate   DateTime?
  active    Boolean        @default(false)
  pairings  Pairing[]
  meetings  TutorMeeting[]
  createdAt DateTime       @default(now())
}

model Tutor {
  id          String   @id @default(cuid())
  englishName String
  /// Work/school email. Used to link the Tutor to a User account at first sign-in
  /// (User.email is matched against this).
  email       String?  @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  user               User?
  pairings           Pairing[]
  sessions           Session[]
  adjustments        ServiceHourAdjustment[]
  meetingAttendances MeetingAttendance[]
  availabilities     TutorAvailability[]
}

/// A subject offered for tutoring. The catalog is managed by admins; tutees pick a
/// first (required) and optional second choice from it on the public signup form.
model Course {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  firstChoiceTutees  Tutee[] @relation("TuteeFirstChoice")
  secondChoiceTutees Tutee[] @relation("TuteeSecondChoice")
}

model Tutee {
  id          String      @id @default(cuid())
  englishName String
  email       String?
  phone       String?
  gradeLevel  String?
  notes       String?
  status      TuteeStatus @default(ACTIVE)

  // Course preferences chosen on the signup form (first required, second optional).
  firstChoiceId  String?
  firstChoice    Course? @relation("TuteeFirstChoice", fields: [firstChoiceId], references: [id])
  secondChoiceId String?
  secondChoice   Course? @relation("TuteeSecondChoice", fields: [secondChoiceId], references: [id])

  // Electronic signature: the tutee types their name to agree to the rulebook.
  signedRulebook Boolean   @default(false)
  signatureName  String?
  signedAt       DateTime?

  createdAt DateTime @default(now())

  availabilities TuteeAvailability[]
  pairings       PairingTutee[]
  sessions       SessionTutee[]
  punishments    Punishment[]

  @@index([status])
}

/// A reusable named time slot (e.g. "Mon 3:30–4:30"). The catalog is admin-managed.
/// Tutors and tutees mark which slots they are available for; a Pairing may reference
/// one as its default/reference time. Slots are reference-only — actual session times
/// are still entered on each attendance submission.
model TimeSlot {
  id        String   @id @default(cuid())
  label     String
  dayOfWeek Int // 1 = Monday .. 7 = Sunday
  startMin  Int // minutes from midnight
  endMin    Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  pairings            Pairing[]
  tutorAvailabilities TutorAvailability[]
  tuteeAvailabilities TuteeAvailability[]

  @@index([dayOfWeek, startMin])
}

/// Join: the time slots a tutor has marked themselves available for.
model TutorAvailability {
  tutorId String
  tutor   Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  slotId  String
  slot    TimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@id([tutorId, slotId])
  @@index([slotId])
}

/// Join: the time slots a tutee selected as available on the signup form.
model TuteeAvailability {
  tuteeId String
  tutee   Tutee    @relation(fields: [tuteeId], references: [id], onDelete: Cascade)
  slotId  String
  slot    TimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@id([tuteeId, slotId])
  @@index([slotId])
}

model Room {
  id        String    @id @default(cuid())
  name      String    @unique
  pairings  Pairing[]
  createdAt DateTime  @default(now())
}

model Pairing {
  id        String   @id @default(cuid())
  subject   String
  dayOfWeek Int // 1 = Monday .. 7 = Sunday
  startMin  Int // minutes from midnight
  endMin    Int
  createdAt DateTime @default(now())

  tutorId    String
  tutor      Tutor     @relation(fields: [tutorId], references: [id])
  termId     String
  term       Term      @relation(fields: [termId], references: [id])
  roomId     String?
  room       Room?     @relation(fields: [roomId], references: [id])
  // Optional reference to the catalog time slot this pairing was scheduled into.
  // Reference-only: the day/start/end above remain the source of truth.
  timeSlotId String?
  timeSlot   TimeSlot? @relation(fields: [timeSlotId], references: [id])

  tutees   PairingTutee[]
  sessions Session[]

  @@index([tutorId])
  @@index([termId])
}

/// Join table: the tutees rostered on a pairing.
model PairingTutee {
  pairingId String
  pairing   Pairing @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  tuteeId   String
  tutee     Tutee   @relation(fields: [tuteeId], references: [id], onDelete: Cascade)

  @@id([pairingId, tuteeId])
  @@index([tuteeId])
}

/// One attendance submission for a pairing meeting.
model Session {
  id     String           @id @default(cuid())
  date   DateTime
  status AttendanceStatus

  // Start/end captured at submission (defaults from the pairing, may be overridden).
  startMin Int
  endMin   Int

  // Five 1-5 ratings (nullable when not applicable, e.g. an absence).
  ratingPreparedness  Int?
  ratingParticipation Int?
  ratingUnderstanding Int?
  ratingBehavior      Int?
  ratingProgress      Int?

  comments String?

  // Derived, computed server-side at submit time and stored on the row.
  month       String // "YYYY-MM"
  durationMin Int
  shFactor    Int
  shCount     Float

  createdAt DateTime @default(now())

  pairingId String
  pairing   Pairing @relation(fields: [pairingId], references: [id])
  tutorId   String
  tutor     Tutor   @relation(fields: [tutorId], references: [id])

  tutees SessionTutee[]

  @@index([tutorId, month])
  @@index([pairingId])
}

/// Join table: the tutees covered by a particular attendance submission.
model SessionTutee {
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tuteeId   String
  tutee     Tutee   @relation(fields: [tuteeId], references: [id])

  @@id([sessionId, tuteeId])
  @@index([tuteeId])
}

model TutorMeeting {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  createdAt DateTime @default(now())

  termId String?
  term   Term?   @relation(fields: [termId], references: [id])

  attendances MeetingAttendance[]
}

model MeetingAttendance {
  id     String                  @id @default(cuid())
  status MeetingAttendanceStatus

  meetingId String
  meeting   TutorMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  tutorId   String
  tutor     Tutor        @relation(fields: [tutorId], references: [id])

  @@unique([meetingId, tutorId])
  @@index([tutorId])
}

/// A penalty recorded against a tutee (distinct from tutor service-hour adjustments).
model Punishment {
  id        String   @id @default(cuid())
  reason    String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  tuteeId String
  tutee   Tutee  @relation(fields: [tuteeId], references: [id])

  @@index([tuteeId])
}

/// Per-tutor, per-month service-hour adjustment feeding the monthly total
/// (monthly total = SUM(shCount) - PUNISHMENT amounts + EXTRA amounts).
model ServiceHourAdjustment {
  id        String         @id @default(cuid())
  month     String // "YYYY-MM"
  type      AdjustmentType
  amount    Float
  reason    String?
  createdAt DateTime       @default(now())

  tutorId String
  tutor   Tutor  @relation(fields: [tutorId], references: [id])

  @@index([tutorId, month])
}

model PolicyFile {
  id         String   @id @default(cuid())
  name       String
  path       String // stored file path or URL
  uploadedAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// Auth scaffolding — future email-based 2FA (NOT yet implemented)
//
// These structures exist so the second-factor flow can be added later without a
// disruptive migration. No application code reads or writes them yet; the seams
// live in src/server/auth/two-factor.ts and src/server/email/sender.ts.
// ----------------------------------------------------------------------------

enum VerificationPurpose {
  LOGIN_2FA // emailed one-time code as a login second factor
  // Future: PASSWORD_RESET, EMAIL_CHANGE, ...
}

/// A short-lived, single-use one-time code emailed to a user as a second factor.
/// Only the hash of the code is stored — never the plaintext.
model EmailVerificationCode {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    VerificationPurpose @default(LOGIN_2FA)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())

  @@index([userId])
}
