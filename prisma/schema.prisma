// Prisma schema for the SHBS peer-tutoring management app.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Auth (NextAuth / Auth.js — Credentials provider, JWT sessions)
//
// Sign-in is email + password (verified server-side; see src/server/auth). We use
// JWT sessions (role + tutorId are resolved at sign-in and carried in the token), so
// no adapter `Session`/`Account`/`VerificationToken` tables are needed. Only `User`
// is persisted. A future email-based 2FA second factor plugs in via the scaffolding
// at the bottom of this file (`EmailVerificationCode`) — not yet implemented.
// ----------------------------------------------------------------------------

enum Role {
  TUTOR
  COORDINATOR
  ADMIN
}

model User {
  id    String  @id @default(cuid())
  name  String?
  /// Login identifier. Also the address future email-based 2FA codes are sent to.
  email String  @unique

  /// scrypt password hash (see src/server/auth/password.ts). Null until a password is set.
  passwordHash String?

  /// True for auto-provisioned accounts that signed in with the shared default password —
  /// the first-login onboarding forces a real password (and email) before the dashboard.
  mustChangePassword Boolean @default(false)

  /// SCAFFOLDING for future email-based 2FA — see src/server/auth/two-factor.ts.
  /// When true, an emailed one-time code will be required as a second factor at
  /// sign-in. Not yet enforced anywhere.
  twoFactorEnabled Boolean @default(false)

  /// Set when the user completes first-login onboarding (`/onboarding/email`): they
  /// confirm the contact email their sign-in codes go to (email-2FA setup is scaffolded).
  /// Null = onboarding not done yet; the tutor shell routes them to the gate.
  emailVerifiedAt DateTime?

  role Role @default(TUTOR)

  // Optional link to the domain Tutor record (matched by email at first sign-in).
  tutor   Tutor?  @relation(fields: [tutorId], references: [id])
  tutorId String? @unique

  /// SCAFFOLDING — future email 2FA codes (see EmailVerificationCode). Unused for now.
  verificationCodes EmailVerificationCode[]

  /// SCAFFOLDING — forgot-password reset tokens (see PasswordResetToken).
  passwordResets PasswordResetToken[]

  // Announcements this user (admin) broadcast, and the ones they've acknowledged.
  announcements    Announcement[]    @relation("AnnouncementAuthor")
  announcementAcks AnnouncementAck[]
  // Disciplinary cards this user (admin) reviewed (flagged valid/invalid).
  cardReviews      DisciplinaryCard[] @relation("CardReviewer")
  // Policy documents this user (admin) last edited.
  policyEdits      PolicyDocument[]   @relation("PolicyEditor")
  // In-app notifications addressed to this user.
  notifications    Notification[]

  createdAt DateTime @default(now())
}

/// An audit record of an admin mutation, with optional typed data to revert it. Actor
/// id/name are denormalised so history survives user deletion. See src/server/audit/log.ts.
model AuditLog {
  id        String    @id @default(cuid())
  userId    String?
  userName  String?
  action    String // human-readable, e.g. "Deleted course \"Physics\""
  entity    String // e.g. "Course"
  entityId  String?
  /// Typed payload describing how to undo this action; null = not auto-revertible.
  undoData  Json?
  undone    Boolean   @default(false)
  undoneAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

/// A lightweight in-app notification for any user (tutor / coordinator / admin).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  /// Optional in-app link the notification points to (e.g. "/dashboard").
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// ----------------------------------------------------------------------------
// Domain
// ----------------------------------------------------------------------------

enum Quarter {
  Q3
  Q4
}

/// Lifecycle of a tutee record. Public self-signups start PENDING and are reviewed by
/// an admin (who assigns them to a tutor); admins create tutees as ACTIVE directly.
enum TuteeStatus {
  PENDING
  ACTIVE
  INACTIVE
}

/// The tutor's own status for a session (whether the session was held).
enum SessionTutorStatus {
  PRESENT
  RESCHEDULED
  EXTRA
  TUTOR_ABSENT
}

/// A single tutee's attendance at a held session.
enum TuteeAttendanceStatus {
  PRESENT
  EXCUSED_ABSENT
  UNEXCUSED_ABSENT
}

/// Tutor meeting attendance: P / EA / UA / X.
enum MeetingAttendanceStatus {
  PRESENT // P
  EXCUSED_ABSENT // EA
  UNEXCUSED_ABSENT // UA
  EXEMPT // X
}

/// Direction of a per-tutor monthly service-hour adjustment.
enum AdjustmentType {
  PUNISHMENT // subtracts hours
  EXTRA // adds hours
}

/// Admin-managed difficulty/track levels (e.g. AP / Honors / Standard). `apScored` marks a
/// level whose courses can carry an AP exam score — it gates the AP-score field on tutor
/// applications. `rank` orders the catalogue.
model CourseLevel {
  id        String   @id @default(cuid())
  name      String   @unique
  rank      Int      @default(0)
  apScored  Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  courses Course[]
}

model Term {
  id        String         @id @default(cuid())
  quarter   Quarter
  name      String // e.g. "2025-2026 Q3"
  startDate DateTime?
  endDate   DateTime?
  active    Boolean        @default(false)
  pairings  Pairing[]
  meetings  TutorMeeting[]
  createdAt DateTime       @default(now())
}

model Tutor {
  id          String   @id @default(cuid())
  /// Split name. `englishName` is kept as the canonical display name (= "First Last")
  /// so the many places that render it don't change.
  firstName   String?
  lastName    String?
  englishName String
  /// Free-text alternative name(s) — full Unicode (e.g. 简体中文 / 漢字 / etc.). Display only;
  /// shown alongside englishName. No charset restriction is applied anywhere.
  alternativeNames String?
  /// Login handle — default is first initial + full last name (e.g. "jsmith"), lowercased.
  /// Unique; lets a tutor sign in with username OR email. Resolved to the User via the
  /// `user` relation in the Credentials authorize().
  username    String?  @unique
  /// Work/school email. Used to link the Tutor to a User account at first sign-in
  /// (User.email is matched against this).
  email       String?  @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  user                 User?
  pairings             Pairing[]
  sessions             Session[]
  adjustments          ServiceHourAdjustment[]
  meetingAttendances   MeetingAttendance[]
  availabilities       TutorAvailability[]
  interviewAssignments InterviewAssignment[]
  // Disciplinary cards this tutor issued, interview votes they cast, and applications
  // they decided as head interviewer.
  issuedCards          DisciplinaryCard[]    @relation("CardIssuer")
  interviewVotes       InterviewVote[]
  applicationDecisions TutorApplication[]    @relation("AppDecider")
}

/// A subject offered for tutoring. The catalog is managed by admins; tutees pick a
/// first (required) and optional second choice from it on the public signup form.
model Course {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Difficulty/track level from the admin-managed catalogue (CourseLevel). Optional.
  levelId   String?
  level     CourseLevel? @relation(fields: [levelId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  firstChoiceTutees  Tutee[]                   @relation("TuteeFirstChoice")
  secondChoiceTutees Tutee[]                   @relation("TuteeSecondChoice")
  applicationIntents ApplicationCourseIntent[]
}

model Tutee {
  id          String      @id @default(cuid())
  englishName String
  email       String?
  phone       String?
  /// Free-text "how can we reach you?" captured on the public signup form (required there).
  preferredContact String?
  gradeLevel  String?
  notes       String?
  status      TuteeStatus @default(ACTIVE)

  // Course preferences chosen on the signup form (first required, second optional).
  firstChoiceId  String?
  firstChoice    Course? @relation("TuteeFirstChoice", fields: [firstChoiceId], references: [id])
  secondChoiceId String?
  secondChoice   Course? @relation("TuteeSecondChoice", fields: [secondChoiceId], references: [id])

  // Electronic signature: the tutee types their name to agree to the rulebook.
  signedRulebook Boolean   @default(false)
  signatureName  String?
  signedAt       DateTime?

  createdAt DateTime @default(now())
  /// Optimistic-concurrency token: high-risk mutations pass the value they read and are
  /// rejected if it changed (another coordinator acted first). See src/server/concurrency.ts.
  updatedAt DateTime @updatedAt

  availabilities TuteeAvailability[]
  pairings       PairingTutee[]
  sessions       SessionTutee[]
  cards          DisciplinaryCard[]

  @@index([status])
}

/// A reusable named time slot (e.g. "Mon 3:30–4:30"). The catalog is admin-managed.
/// Tutors and tutees mark which slots they are available for; a Pairing may reference
/// one as its default/reference time. Slots are reference-only — actual session times
/// are still entered on each attendance submission.
model TimeSlot {
  id        String   @id @default(cuid())
  label     String
  dayOfWeek Int // 1 = Monday .. 7 = Sunday
  startMin  Int // minutes from midnight
  endMin    Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  pairings            Pairing[]
  tutorAvailabilities TutorAvailability[]
  tuteeAvailabilities TuteeAvailability[]

  @@index([dayOfWeek, startMin])
}

/// Join: the time slots a tutor has marked themselves available for.
model TutorAvailability {
  tutorId String
  tutor   Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  slotId  String
  slot    TimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@id([tutorId, slotId])
  @@index([slotId])
}

/// Join: the time slots a tutee selected as available on the signup form.
model TuteeAvailability {
  tuteeId String
  tutee   Tutee    @relation(fields: [tuteeId], references: [id], onDelete: Cascade)
  slotId  String
  slot    TimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@id([tuteeId, slotId])
  @@index([slotId])
}

model Room {
  id        String    @id @default(cuid())
  name      String    @unique
  pairings  Pairing[]
  createdAt DateTime  @default(now())

  unavailabilities RoomUnavailability[]
}

/// A recurring weekly period during which a room cannot be used (e.g. another class).
/// Surfaced on the room grid so coordinators don't schedule pairings into a blocked slot.
model RoomUnavailability {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 1 = Monday .. 7 = Sunday
  startMin  Int // minutes from midnight
  endMin    Int
  reason    String?
  createdAt DateTime @default(now())

  @@index([roomId])
}

model Pairing {
  id        String   @id @default(cuid())
  subject   String
  dayOfWeek Int // 1 = Monday .. 7 = Sunday
  startMin  Int // minutes from midnight
  endMin    Int
  createdAt DateTime @default(now())

  tutorId    String
  tutor      Tutor     @relation(fields: [tutorId], references: [id])
  termId     String
  term       Term      @relation(fields: [termId], references: [id])
  roomId     String?
  room       Room?     @relation(fields: [roomId], references: [id])
  // Optional reference to the catalog time slot this pairing was scheduled into.
  // Reference-only: the day/start/end above remain the source of truth.
  timeSlotId String?
  timeSlot   TimeSlot? @relation(fields: [timeSlotId], references: [id])

  tutees   PairingTutee[]
  sessions Session[]

  @@index([tutorId])
  @@index([termId])
}

/// Join table: the tutees rostered on a pairing.
model PairingTutee {
  pairingId String
  pairing   Pairing @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  tuteeId   String
  tutee     Tutee   @relation(fields: [tuteeId], references: [id], onDelete: Cascade)

  @@id([pairingId, tuteeId])
  @@index([tuteeId])
}

/// One attendance submission for a pairing meeting.
model Session {
  id     String             @id @default(cuid())
  date   DateTime
  /// The tutor's own status (did the session happen?). Tutee attendance is per-tutee on
  /// SessionTutee. A reason is captured when the tutor was absent.
  tutorStatus       SessionTutorStatus @default(PRESENT)
  tutorAbsentReason String?

  // Start/end captured at submission (defaults from the pairing, may be overridden).
  startMin Int
  endMin   Int

  // Five 1-5 ratings (nullable when not applicable, e.g. an absence).
  ratingPreparedness  Int?
  ratingParticipation Int?
  ratingUnderstanding Int?
  ratingBehavior      Int?
  ratingProgress      Int?

  comments String?

  // Derived, computed server-side at submit time and stored on the row.
  month       String // "YYYY-MM"
  durationMin Int
  shFactor    Int
  shCount     Float

  createdAt DateTime @default(now())

  pairingId String
  pairing   Pairing @relation(fields: [pairingId], references: [id])
  tutorId   String
  tutor     Tutor   @relation(fields: [tutorId], references: [id])

  tutees SessionTutee[]
  // Disciplinary cards requested via this attendance submission's survey.
  cards  DisciplinaryCard[]

  @@index([tutorId, month])
  @@index([pairingId])
}

/// Join table: the tutees covered by a particular attendance submission.
model SessionTutee {
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tuteeId   String
  tutee     Tutee   @relation(fields: [tuteeId], references: [id])
  /// This tutee's attendance at the session; a reason is captured when excused-absent.
  status        TuteeAttendanceStatus @default(PRESENT)
  absenceReason String?

  @@id([sessionId, tuteeId])
  @@index([tuteeId])
}

model TutorMeeting {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  createdAt DateTime @default(now())

  termId String?
  term   Term?   @relation(fields: [termId], references: [id])

  attendances MeetingAttendance[]
}

model MeetingAttendance {
  id     String                  @id @default(cuid())
  status MeetingAttendanceStatus

  meetingId String
  meeting   TutorMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  tutorId   String
  tutor     Tutor        @relation(fields: [tutorId], references: [id])

  @@unique([meetingId, tutorId])
  @@index([tutorId])
}

/// Per-tutor, per-month service-hour adjustment feeding the monthly total
/// (monthly total = SUM(shCount) - PUNISHMENT amounts + EXTRA amounts).
model ServiceHourAdjustment {
  id        String         @id @default(cuid())
  month     String // "YYYY-MM"
  type      AdjustmentType
  amount    Float
  reason    String?
  createdAt DateTime       @default(now())

  tutorId String
  tutor   Tutor  @relation(fields: [tutorId], references: [id])

  @@index([tutorId, month])
}

// ----------------------------------------------------------------------------
// Tutor applications + interview workflow
//
// Prospective tutors apply via the public form (no login is created). Admins assign up
// to three existing tutors as interviewers — one marked head — and the head schedules the
// interview time, which surfaces on each interviewer's dashboard.
// ----------------------------------------------------------------------------

enum TutorApplicationStatus {
  PENDING // submitted, awaiting interviewer assignment
  INTERVIEW // interviewers assigned / scheduling
  ACCEPTED
  REJECTED
}

model TutorApplication {
  id              String                 @id @default(cuid())
  name            String
  /// Contact email. SCAFFOLDING: future email-based 2FA / verification codes for the
  /// applicant would be sent here (see src/server/auth/two-factor.ts); not wired yet.
  email           String
  /// Free-text "how can we reach you?" captured on the public application form (required there).
  preferredContact String?
  contactVerified Boolean                @default(false)
  status          TutorApplicationStatus @default(PENDING)
  /// Interview time, coordinated by the head interviewer.
  interviewAt     DateTime?
  /// Head interviewer's final decision: recorded on the head's page with a brief comment.
  /// The per-panelist tally lives in `votes`; `status` reflects the outcome (ACCEPTED/REJECTED).
  decisionComment   String?
  decidedAt         DateTime?
  decidedByTutorId  String?
  decidedByTutor    Tutor?    @relation("AppDecider", fields: [decidedByTutorId], references: [id])
  createdAt       DateTime               @default(now())
  /// Optimistic-concurrency token (see src/server/concurrency.ts).
  updatedAt       DateTime               @updatedAt

  courseIntents ApplicationCourseIntent[]
  interviewers  InterviewAssignment[]
  votes         InterviewVote[]

  @@index([status])
}

/// One intended tutoring course on an application (max 3 enforced in the form/mutation),
/// with whether the applicant has taken it and the grade / AP score they received.
model ApplicationCourseIntent {
  id            String           @id @default(cuid())
  applicationId String
  application   TutorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course           @relation(fields: [courseId], references: [id])
  taken         Boolean          @default(false)
  grade         String? // class grade received, when taken
  /// Whether the applicant has an AP score for this (AP-tagged) course.
  hasApScore    Boolean          @default(false)
  apScore       String? // AP score, only when hasApScore
  /// Whether the applicant self-studied this course instead of taking the class.
  selfStudied   Boolean          @default(false)
  selfStudyNote String? // how they qualify / what they achieved, when selfStudied

  @@index([applicationId])
}

/// Join: a tutor assigned to interview an applicant. Exactly one per application is head.
model InterviewAssignment {
  applicationId String
  application   TutorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tutorId       String
  tutor         Tutor            @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  isHead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@id([applicationId, tutorId])
  @@index([tutorId])
}

/// One panelist's vote on an applicant after the demonstration (accept = simple majority
/// admits; the head breaks ties). The head reads the tally + comments before deciding.
model InterviewVote {
  applicationId String
  application   TutorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tutorId       String
  tutor         Tutor            @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  accept        Boolean
  comment       String?
  createdAt     DateTime         @default(now())

  @@id([applicationId, tutorId])
  @@index([tutorId])
}

model PolicyFile {
  id         String   @id @default(cuid())
  name       String
  path       String // stored file path or URL
  uploadedAt DateTime @default(now())
}

/// An editable policy document (e.g. the tutor / tutee handbooks). Body is Markdown, edited
/// in the admin area (/admin/policies) and seeded from the published handbooks.
model PolicyDocument {
  id          String   @id @default(cuid())
  /// Stable key, e.g. "tutor-policy" / "tutee-policy".
  slug        String   @unique
  title       String
  body        String // Markdown
  version     String?
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("PolicyEditor", fields: [updatedById], references: [id])
}

// ----------------------------------------------------------------------------
// Discipline — tutee yellow/red cards (the "punishment" system in the policy)
//
// Tutors request cards via the attendance survey (source TUTOR, with a required reason),
// and the team rechecks each, flagging it VALID or INVALID. The system also auto-issues
// cards from attendance (source AUTO, e.g. unexcused absence -> red). Standing is derived
// from VALID cards: 3 yellows count as 1 red, and 2 reds = removal-pending. The escalation
// tally is computed (see src/lib/discipline.ts), not materialized, to avoid double counting.
// ----------------------------------------------------------------------------

enum CardColor {
  YELLOW
  RED
}

/// Where a card came from: a tutor's survey request, or automatic policy issuance.
enum CardSource {
  TUTOR
  AUTO
}

/// Team review state of a card. TUTOR cards start PENDING (await recheck); AUTO cards are
/// created VALID (rule-based) but can still be flagged INVALID on appeal.
enum CardReviewStatus {
  PENDING
  VALID
  INVALID
}

model DisciplinaryCard {
  id           String           @id @default(cuid())
  tuteeId      String
  tutee        Tutee            @relation(fields: [tuteeId], references: [id], onDelete: Cascade)
  color        CardColor
  source       CardSource       @default(TUTOR)
  /// Required justification: the tutor's comment, or the auto-issue reason.
  reason       String?
  reviewStatus CardReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?            @relation("CardReviewer", fields: [reviewedById], references: [id])
  // For TUTOR-sourced cards: who requested it and via which attendance submission.
  issuedByTutorId String?
  issuedByTutor   Tutor?        @relation("CardIssuer", fields: [issuedByTutorId], references: [id])
  sessionId       String?
  session         Session?      @relation(fields: [sessionId], references: [id])
  createdAt    DateTime         @default(now())
  /// Optimistic-concurrency token (see src/server/concurrency.ts).
  updatedAt    DateTime         @updatedAt

  @@index([tuteeId])
  @@index([reviewStatus])
}

// ----------------------------------------------------------------------------
// Announcements — broadcast by the team, shown to tutors on every login until acknowledged
// ----------------------------------------------------------------------------

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  /// Pinned announcements stay surfaced even after acknowledgement.
  pinned      Boolean  @default(false)
  active      Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("AnnouncementAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  acks AnnouncementAck[]

  @@index([active])
}

/// Records that a user dismissed/acknowledged an announcement (so it stops popping on login).
model AnnouncementAck {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ackedAt        DateTime     @default(now())

  @@id([announcementId, userId])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Auth scaffolding — future email-based 2FA (NOT yet implemented)
//
// These structures exist so the second-factor flow can be added later without a
// disruptive migration. No application code reads or writes them yet; the seams
// live in src/server/auth/two-factor.ts and src/server/email/sender.ts.
// ----------------------------------------------------------------------------

enum VerificationPurpose {
  LOGIN_2FA // emailed one-time code as a login second factor
  PASSWORD_RESET // forgot-password reset (see PasswordResetToken)
  // Future: EMAIL_CHANGE, ...
}

/// A short-lived, single-use one-time code emailed to a user as a second factor.
/// Only the hash of the code is stored — never the plaintext.
model EmailVerificationCode {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    VerificationPurpose @default(LOGIN_2FA)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())

  @@index([userId])
}

/// A short-lived, single-use password-reset token for the forgot-password flow.
/// Only the token *hash* is stored — the plaintext goes in the emailed reset link.
/// The token logic (issue/verify) is implemented in src/server/auth/password-reset.ts;
/// email DELIVERY is scaffolded only (no provider wired up — see src/server/email/sender.ts).
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
