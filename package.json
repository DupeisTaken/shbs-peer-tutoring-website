{
  "name": "shbs-peer-tutoring-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --turbopack",
    "admin:create": "tsx scripts/create-admin.ts",
    "check": "eslint . && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "dev": "next dev --turbopack",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build --turbopack && next start",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs && node --test scripts/docs.test.mjs"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.12",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.101.2",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "dotenv": "^17.4.2",
    "geist": "^1.7.2",
    "next": "^16.3.3",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.1",
    "nodemailer": "9.1.1",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.81.0",
    "react-markdown": "^9.1.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "tsx": "^4.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.3",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.0.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "prisma": {
      "mysql2": "3.24.4"
    },
    "deepmerge-ts": "8.0.0",
    "postcss": "$postcss"
  },
  "packageManager": "npm@11.13.0"
}
