# next-auth v5 (beta) and @auth/core declare conflicting *optional* peer deps on nodemailer
# (6.x vs 7.x). We use the Credentials provider, not nodemailer's auth integration, so the
# conflict is irrelevant — but installing nodemailer (for Aliyun Direct Mail email delivery)
# trips npm's strict peer resolver. legacy-peer-deps lets `npm install` / `npm ci` proceed.
legacy-peer-deps=true
